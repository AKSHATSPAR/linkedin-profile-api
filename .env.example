# Use a separate, revocable LinkedIn session. Never commit real values.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
# Optional legacy input; production secrets use a structured "cookies" object.
LINKEDIN_COOKIE_HEADER=
LINKEDIN_SECRET_CACHE_TTL_SECONDS=300

# Production alternative: an AWS Secrets Manager JSON secret containing
# {"li_at":"...", "jsessionid":"...", "cookies":{"li_at":"...","JSESSIONID":"..."}}
LINKEDIN_SECRET_ARN=
AWS_REGION=ap-south-1

LINKEDIN_REQUEST_TIMEOUT_SECONDS=6
LINKEDIN_TOTAL_TIMEOUT_SECONDS=10
LINKEDIN_MAX_RETRIES=1
LINKEDIN_MAX_UPSTREAM_REQUESTS=8
LINKEDIN_MAX_RESPONSE_BYTES=2000000
LINKEDIN_FETCH_SECTION_FALLBACKS=false
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=128
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_MAX_CLIENTS=2048
MAX_REQUEST_BODY_BYTES=4096
LOG_LEVEL=INFO
