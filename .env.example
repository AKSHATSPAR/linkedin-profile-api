# Use a separate, revocable LinkedIn session. Never commit real values.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Production alternative: an AWS Secrets Manager JSON secret containing
# {"li_at":"...", "jsessionid":"..."}
LINKEDIN_SECRET_ARN=
AWS_REGION=ap-south-1

LINKEDIN_REQUEST_TIMEOUT_SECONDS=20
LINKEDIN_MAX_RETRIES=2
LINKEDIN_FETCH_SECTION_FALLBACKS=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=128
RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO

